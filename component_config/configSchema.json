{
  "type": "object",
  "title": "ABRA Flexi connection",
  "required": ["base_url", "company", "username", "#password"],
  "properties": {
    "base_url": {
      "type": "string",
      "title": "Base URL",
      "description": "ABRA Flexi instance URL, e.g. https://demo.flexibee.eu",
      "propertyOrder": 1
    },
    "company": {
      "type": "string",
      "title": "Company (firma)",
      "description": "Company identifier (firma) from the URL path",
      "propertyOrder": 2
    },
    "username": {
      "type": "string",
      "title": "Username",
      "propertyOrder": 3
    },
    "#password": {
      "type": "string",
      "title": "Password",
      "format": "password",
      "propertyOrder": 4
    },
    "ssl_verify": {
      "type": "boolean",
      "title": "Verify SSL certificate",
      "description": "Verify TLS certificate (disable only for self-signed on-prem certs)",
      "default": true,
      "propertyOrder": 5
    },
    "debug": {
      "type": "boolean",
      "title": "Debug",
      "description": "Verbose logging",
      "default": false,
      "propertyOrder": 6
    },
    "test_connection": {
      "type": "button",
      "format": "sync-action",
      "propertyOrder": 7,
      "options": {
        "async": {
          "label": "Test connection",
          "action": "testConnection"
        }
      }
    }
  }
}
